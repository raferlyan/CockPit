{
  "name": "cockpit",
  "version": "0.8.0",
  "description": "Android 设备投屏、终端与状态监控桌面工具",
  "main": "./out/main/index.js",
  "author": "raferlyan",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "fetch-server": "node scripts/fetch-scrcpy-server.mjs",
    "fetch-perfetto": "node scripts/fetch-perfetto-ui.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mp4-muxer": "^5.2.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "node-pty@1.1.0": true,
    "@serialport/bindings-cpp@13.0.0": true
  }
}
